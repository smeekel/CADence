#
# clang-tidy configuration for scripts/analyze.ps1 (T-11). Run through the Visual Studio clang-tidy integration
# (build/props/CodeAnalysis.props) with the VS-bundled LLVM. Every finding fails scripts/analyze.ps1; suppress a
# finding only with NOLINT(<check>) and a reason on the same line. portability-avoid-pragma-once is off because
# rule 010 requires #pragma once in every header.
Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  portability-*,
  -portability-avoid-pragma-once,
  misc-definitions-in-headers,
  misc-redundant-expression,
  misc-unused-using-decls
WarningsAsErrors: ''
FormatStyle: none
# The header filter in build/props/CodeAnalysis.props matches any path with a src or tests folder, which includes
# third-party trees such as vcpkg_installed/<tree>/x64-windows/include/eigen3/Eigen/src (ADR 0022).
ExcludeHeaderFilterRegex: '.*[\\/]vcpkg_installed[\\/].*'
CheckOptions:
  # app::Result<T> is std::expected<T, app::Error> (ADR 0042); a dropped Result is a dropped error.
  bugprone-unused-return-value.CheckedReturnTypes: '::std::error_code;::std::error_condition;::std::errc;::std::expected'
