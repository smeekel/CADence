# Doxygen configuration for APP. Only non-default settings are listed.
# Run: scripts/docs.ps1   (or: create out/docs, then run "doxygen Doxyfile"; Doxygen does not create nested output folders)
# Output: out/docs/html/index.html. scripts/docs.ps1 -Pdf also writes out/docs/latex/ and builds refman.pdf there
# (needs a LaTeX distribution such as MiKTeX).
# Everything works offline: no CDN-hosted MathJax, client-side search only.

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "APP"
PROJECT_BRIEF          = "Integrated MCAD + ECAD desktop CAD"
PROJECT_NUMBER         = 0.0.0
OUTPUT_DIRECTORY       = out/docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = src
STRIP_FROM_INC_PATH    = src
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
INHERIT_DOCS           = YES
TAB_SIZE               = 4

# Custom commands
#   @req  M-SKT-02     -> links the documented item to a requirement; builds the "Requirements Traceability" page
#   @cmd  name         -> documents the command-bus name an operation is exposed as
#   @units text        -> states the units of a parameter or return value
ALIASES                = "req=@xrefitem req \"Requirement\" \"Requirements Traceability\"" \
                         "cmd=@par Command:^^@c" \
                         "units=@par Units:^^"

#---------------------------------------------------------------------------
# Build
#---------------------------------------------------------------------------
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
CASE_SENSE_NAMES       = NO
SHOW_INCLUDE_FILES     = YES
SORT_MEMBER_DOCS       = NO
GENERATE_TODOLIST      = YES
GENERATE_BUGLIST       = YES
GENERATE_DEPRECATEDLIST= YES

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = out/docs/doxygen-warnings.log

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = docs/mainpage.md \
                         docs/FOLDER_STRUCTURE.md \
                         docs/format \
                         docs/commands \
                         docs/adr \
                         src
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.hpp *.cpp *.md
RECURSIVE              = YES
# Root-relative folders, not patterns: a pattern such as */out/* would also drop src/ecad/out.
EXCLUDE                = tests \
                         out \
                         vcpkg_installed \
                         third_party
USE_MDFILE_AS_MAINPAGE = docs/mainpage.md
# Keep src/<module>/README.md as pages with their {#module-...} anchors instead of directory docs.
IMPLICIT_DIR_DOCS      = NO
IMAGE_PATH             = docs/images

#---------------------------------------------------------------------------
# Source browsing
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO

#---------------------------------------------------------------------------
# HTML
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = TOGGLE
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
USE_MATHJAX            = NO

#---------------------------------------------------------------------------
# LaTeX / PDF
#---------------------------------------------------------------------------
# Off by default: LaTeX output converts class diagrams with epstopdf, which needs a TeX installation.
# scripts/docs.ps1 -Pdf turns it on.
GENERATE_LATEX         = NO
LATEX_OUTPUT           = latex
USE_PDFLATEX           = YES
PDF_HYPERLINKS         = YES
PAPER_TYPE             = a4
COMPACT_LATEX          = NO
LATEX_BATCHMODE        = YES

#---------------------------------------------------------------------------
# Other outputs (off by default)
#---------------------------------------------------------------------------
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

#---------------------------------------------------------------------------
# Preprocessor
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = APP_DOXYGEN=1 \
                         "APP_API=" \
                         "Q_OBJECT="

#---------------------------------------------------------------------------
# Diagrams (Graphviz optional; set HAVE_DOT = YES if dot.exe is installed)
#---------------------------------------------------------------------------
HAVE_DOT               = NO
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
