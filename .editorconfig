# SPDX-License-Identifier: GPL-3.0-or-later
root = true

[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true
indent_style             = space
indent_size              = 4

[*.{h,hpp,cpp,ipp,inl}]
indent_size = 4
max_line_length = 120

[*.{json,schema.json}]
indent_size = 2

[*.{vcxproj,vcxproj.filters,props,targets,slnx,xml}]
indent_size = 2
end_of_line = crlf

[*.{ps1,cmd,bat}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
