{
  "name": "app",
  "version-semver": "0.0.0",
  "description": "APP (working name): integrated MCAD + ECAD desktop CAD.",
  "license": "GPL-3.0-or-later",
  "supports": "windows & x64",
  "dependencies": [
    {
      "name": "gtest",
      "version>=": "1.18.0"
    }
  ],
  "features": {
    "ui": {
      "description": "Qt 6 Widgets user interface (src/ui, tests/ui). Enabled for Debug and Release, never for Headless.",
      "dependencies": [
        {
          "name": "qtbase",
          "version>=": "6.11.3#1",
          "default-features": false,
          "features": [
            "gui",
            "widgets"
          ]
        }
      ]
    }
  },
  "overrides": [
    {
      "name": "double-conversion",
      "version": "3.4.0"
    },
    {
      "name": "gtest",
      "version": "1.18.0"
    },
    {
      "name": "md4c",
      "version": "0.6.0"
    },
    {
      "name": "pcre2",
      "version": "10.49",
      "port-version": 2
    },
    {
      "name": "qtbase",
      "version": "6.11.3",
      "port-version": 1
    },
    {
      "name": "zlib",
      "version": "1.3.2",
      "port-version": 3
    }
  ]
}
